# Optional overrides for local Docker Compose. Copy to .env to use them.
# The values below are demo-only defaults; do not use them outside local development.
POSTGRES_DB=kursova
POSTGRES_USER=kursova
POSTGRES_PASSWORD=kursova_demo_password

# Host ports (change only if the default port is already in use)
BACKEND_PORT=3000
FRONTEND_PORT=8080

# Secret for signing login tokens (demo-only default is used if unset)
JWT_SECRET=kursova-demo-only-secret
